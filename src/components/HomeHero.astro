---
import type { HomeLink } from '../lib/home-links';

interface Props { links: HomeLink[] }
const { links } = Astro.props;
const heroPoster = '/assets/images/yumulab-top-poster.jpg';
---

<section class="home-hero" aria-labelledby="home-heading">
  <img class="hero-media" src={heroPoster} alt="" width="1280" height="720" fetchpriority="high" />
  <video
    id="home-video"
    class="hero-media hero-video"
    data-src="/assets/yumulab-top.mp4"
    poster={heroPoster}
    width="1280"
    height="720"
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    tabindex="-1"
  />
  <div class="wrapper hero-content">
    <h1 id="home-heading" class="visually-hidden">北海道情報大学 情報メディア学部 情報メディア学科 湯村研究室</h1>
    <p>北海道情報大学 情報メディア学部 情報メディア学科</p>
    <nav class="hero-links" aria-label="研究室のご案内">
      {links.map(({ href, label }) => (
        <a href={href}><span>{label}</span><span aria-hidden="true">↗</span></a>
      ))}
    </nav>
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('#home-video');
  if (video) {
    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
    let failed = false;
    const play = async () => {
      if (failed) return;
      if (!video.getAttribute('src')) video.src = video.dataset.src!;
      try {
        await video.play();
      } catch {
        // Autoplay may be blocked. Keep displaying the poster.
      }
    };
    const applyMotionPreference = () => {
      video.autoplay = !motionPreference.matches;
      if (motionPreference.matches) video.pause();
      else void play();
    };
    video.muted = true;
    video.addEventListener('error', () => {
      failed = true;
      video.hidden = true;
    });
    motionPreference.addEventListener('change', applyMotionPreference);
    applyMotionPreference();
  }
</script>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 500px;
    max-height: 840px;
    overflow: hidden;
    background: #171625;
    color: #fff;
  }
  .hero-media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -3; }
  .hero-video { z-index: -2; }
  .home-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgb(11 10 24 / 80%), transparent 75%), linear-gradient(90deg, rgb(11 10 24 / 25%), transparent 70%);
    pointer-events: none;
  }
  .hero-content { padding-block: 56px; }
  .hero-content p { margin: 0; font-size: clamp(0.75rem, 1.1vw, 0.95rem); letter-spacing: 0.06em; text-shadow: 0 1px 4px rgb(0 0 0 / 40%); }
  .hero-links { display: flex; flex-wrap: wrap; gap: 16px 28px; margin-top: 28px; }
  .hero-links a { display: flex; align-items: center; justify-content: space-between; gap: 22px; min-height: 44px; padding-bottom: 8px; border-bottom: 1px solid rgb(255 255 255 / 65%); color: #fff; font-size: 0.9rem; }
  .hero-links a:hover { text-decoration: none; border-bottom-color: #fff; }
  .hero-links a:focus-visible { outline: 2px solid #fff; outline-offset: 5px; }
  .hero-video[hidden] { display: none; }
  @media (max-width: 760px) {
    .home-hero { aspect-ratio: 4 / 3; min-height: 540px; max-height: none; }
    .hero-content { padding-block: 40px; }
    .hero-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 20px; margin-top: 24px; }
    .hero-links a { font-size: 0.8rem; gap: 10px; }
  }
</style>
