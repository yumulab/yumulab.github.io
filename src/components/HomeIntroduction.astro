---
import { load } from 'cheerio';

interface Props { html: string }
const { html } = Astro.props;
const $ = load(html, null, false);
const links = $('ul').first().addClass('intro-links');
links.find('a').each((_, element) => {
  const link = $(element);
  link.text(link.text().replace(/^[A-Za-z ]+:\s*/, ''));
});

const socials = $('ul').eq(1).addClass('intro-socials');
socials.prev('p').addClass('social-heading').text('研究室の発信');
socials.find('a').each((_, element) => {
  const link = $(element);
  link.text(link.text().replace(/^Twitter\b/, 'X'));
});
---

<section class="home-introduction" aria-label="研究室のご案内" set:html={$.html()} />

<style>
  .home-introduction { margin-bottom: 60px; }
  .home-introduction :global(> p:first-child) { max-width: 820px; margin: 0 0 20px; line-height: 1.9; }
  .home-introduction :global(ul) { display: flex; flex-wrap: wrap; column-gap: 28px; padding: 0; margin: 0; list-style: none; }
  .home-introduction :global(li) { max-width: 100%; }
  .home-introduction :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text);
    line-height: 1.7;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: #c6c6c6;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .home-introduction :global(a:hover) { color: var(--accent); text-decoration-color: currentColor; }
  .home-introduction :global(.social-heading) { margin: 24px 0 2px; color: var(--muted); font-size: 0.8rem; }
  .home-introduction :global(.intro-socials a) { color: #666; font-size: 0.88rem; }
  .home-introduction :global(.intro-socials a:hover) { color: var(--accent); }
  .home-introduction :global(hr) { display: none; }
  @media (max-width: 760px) {
    .home-introduction { margin-bottom: 44px; }
    .home-introduction :global(ul) { column-gap: 24px; }
  }
</style>
