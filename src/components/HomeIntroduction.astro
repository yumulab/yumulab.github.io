---
import { load } from 'cheerio';

interface Props { html: string }
const { html } = Astro.props;
const $ = load(html, null, false);
const cards = $('ul').first().addClass('intro-cards');
const details: Record<string, { heading: string; description: string }> = {
  '/about.html': { heading: 'ABOUT', description: '研究テーマ・活動方針' },
  '/people.html': { heading: 'PEOPLE', description: '教員・学生の紹介' },
  'https://dl.yumulab.org/': { heading: 'PUBLICATIONS', description: '論文レポジトリ' },
  '/collaboration.html': { heading: 'COLLABORATION', description: '研究室とのコラボレーション' },
  '/yumura.html': { heading: 'FACULTY', description: '教員のプロフィール' },
};
cards.find('a').each((_, element) => {
  const link = $(element);
  const detail = details[link.attr('href') ?? ''];
  const title = link.text().replace(/^[A-Za-z ]+:\s*/, '').replace(/\([^)]*\)/g, '').trim();
  link.addClass('intro-card').empty();
  if (detail) link.append($('<span class="card-heading" />').text(detail.heading));
  link.append($('<span class="card-title" />').text(title));
  if (detail) link.append($('<span class="card-description" />').text(detail.description));
  link.append('<span class="card-arrow" aria-hidden="true">↗</span>');
});

const socials = $('ul').eq(1).addClass('intro-socials');
socials.prev('p').addClass('social-heading').text('Social & Media');
const socialMarks: Record<string, string> = {
  'twitter.com': 'X', 'x.com': 'X', 'www.instagram.com': 'IG',
  'www.facebook.com': 'f', 'speakerdeck.com': 'SD', 'www.youtube.com': '▶',
};
socials.find('a').each((_, element) => {
  const link = $(element);
  const label = link.text().replace(/^Twitter\b/, 'X');
  link.addClass('social-link').empty();
  const hostname = new URL(link.attr('href') ?? '/', 'https://www.yumulab.org').hostname;
  link.append($('<span class="social-mark" aria-hidden="true" />').text(socialMarks[hostname] ?? '↗'));
  link.append($('<span />').text(label));
  link.append('<span class="social-arrow" aria-hidden="true">↗</span>');
});
---

<section class="home-introduction" aria-label="研究室のご案内" set:html={$.html()} />

<style>
  .home-introduction { --link-ink: #211665; margin-bottom: 64px; }
  .home-introduction :global(> p:first-child) { max-width: 820px; margin: 0 0 32px; font-size: clamp(1rem, 1.3vw, 1.15rem); line-height: 2; }
  .home-introduction :global(ul) { padding: 0; margin: 0; list-style: none; }
  .home-introduction :global(.intro-cards) { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }
  .home-introduction :global(.intro-card) {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 174px;
    padding: 24px 20px;
    border: 1px solid #e4e2ee;
    border-radius: 8px;
    background: #fcfbff;
    color: var(--link-ink);
    text-decoration: none;
    transition: background-color 180ms, border-color 180ms, box-shadow 180ms;
  }
  .home-introduction :global(.intro-card:hover) { background: #f2effa; border-color: #b6acd7; box-shadow: 0 6px 20px rgb(33 22 101 / 6%); }
  .home-introduction :global(.intro-card:focus-visible), .home-introduction :global(.social-link:focus-visible) { outline-color: var(--link-ink); }
  .home-introduction :global(.card-heading) { margin-bottom: 18px; font-size: 0.65rem; font-weight: 600; letter-spacing: 0.12em; }
  .home-introduction :global(.card-title) { color: #29243c; font-size: 1.03rem; font-weight: 600; line-height: 1.5; }
  .home-introduction :global(.card-description) { margin-top: 7px; padding-bottom: 20px; color: #777181; font-size: 0.75rem; line-height: 1.7; }
  .home-introduction :global(.card-arrow) { position: absolute; right: 18px; bottom: 14px; font-size: 1.1rem; }
  .home-introduction :global(.social-heading) { margin: 32px 0 14px; color: #777181; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; }
  .home-introduction :global(.intro-socials) { display: flex; flex-wrap: wrap; gap: 10px; }
  .home-introduction :global(.social-link) { display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 8px 14px 8px 10px; border: 1px solid var(--line); border-radius: 24px; color: #514b60; font-size: 0.8rem; text-decoration: none; transition: border-color 180ms, background-color 180ms; }
  .home-introduction :global(.social-link:hover) { border-color: #b6acd7; background: #f6f4fb; }
  .home-introduction :global(.social-mark) { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: #f0edf7; color: var(--link-ink); font-size: 0.7rem; font-weight: 600; }
  .home-introduction :global(.social-arrow) { margin-left: 4px; color: #938b9f; }
  .home-introduction :global(hr) { display: none; }
  @media (max-width: 1040px) {
    .home-introduction :global(.intro-cards) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .home-introduction { margin-bottom: 44px; }
    .home-introduction :global(.intro-cards) { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .home-introduction :global(.intro-card) { min-height: 156px; padding: 20px 16px; }
    .home-introduction :global(.card-heading) { margin-bottom: 14px; font-size: 0.6rem; }
    .home-introduction :global(.card-title) { font-size: 0.95rem; }
  }
  @media (max-width: 380px) {
    .home-introduction :global(.intro-cards) { grid-template-columns: minmax(0, 1fr); }
    .home-introduction :global(.intro-card) { min-height: 140px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-introduction :global(a) { transition: none; }
  }
</style>
