---
import type { HomeLink } from '../lib/home-links';
import { site } from '../site.config';

interface Props { links: HomeLink[] }
const { links } = Astro.props;
const icons: Record<string, string> = {
  'twitter.com': 'x', 'x.com': 'x', 'instagram.com': 'instagram',
  'facebook.com': 'facebook', 'speakerdeck.com': 'speakerdeck', 'note.com': 'note', 'youtube.com': 'youtube',
};
const services = links.map(link => ({
  ...link,
  icon: icons[new URL(link.href, site.url).hostname.replace(/^www\./, '')],
}));
---

<section class="social-links" aria-labelledby="social-heading">
  <h2 id="social-heading">研究室の発信</h2>
  <ul>
    {services.map(({ href, label, icon }) => (
      <li>
        <a href={href}>
          {icon && <img src={`/assets/images/social/${icon}.svg`} width="26" height="26" alt="" />}
          <span>{label}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .social-links { padding-bottom: 28px; margin-bottom: 48px; border-bottom: 1px solid var(--line); }
  h2 { margin: 0 0 16px; color: #666; font-size: 0.9rem; font-weight: 400; }
  ul { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 32px; margin: 0; padding: 0; list-style: none; }
  li { max-width: 100%; }
  a { display: flex; align-items: center; gap: 10px; min-height: 44px; padding-block: 6px; color: #333; font-size: 1.05rem; line-height: 1.6; }
  img { flex: 0 0 26px; width: 26px; height: 26px; object-fit: contain; }
  a:hover { color: var(--accent); text-decoration: none; }
  a:hover span { text-decoration: underline; }
  @media (max-width: 760px) {
    .social-links { margin-bottom: 36px; }
    ul { gap: 8px 24px; }
    a { font-size: 1rem; }
  }
</style>
