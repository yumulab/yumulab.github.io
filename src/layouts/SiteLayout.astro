---
import { site } from '../site.config';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  url: string;
  image?: string;
  articleDate?: string;
  noindex?: boolean;
}

const { title, description = site.description, url, image, articleDate, noindex = false } = Astro.props;
const pageTitle = url === '/' ? site.title : `${title} | ${site.name}`;
const canonical = new URL(url, site.url).href;
const navigation = [
  { label: 'HOME', href: '/' },
  { label: 'ABOUT', href: '/about.html' },
  { label: 'PEOPLE', href: '/people.html' },
  { label: 'PUBLICATIONS', href: 'https://dl.yumulab.org/' },
  { label: 'COLLABORATION', href: '/collaboration.html' },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/atom+xml" title={site.title} href="/feed.xml" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={articleDate ? 'article' : 'website'} />
    {image && <meta property="og:image" content={new URL(image, site.url).href} />}
    {articleDate && <meta property="article:published_time" content={articleDate} />}
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <header class:list={['site-header', { 'site-header-overlay': url === '/' }]}>
      <div class="header-inner">
        <a class="site-brand" href="/" aria-label={site.name}>
          <img src="/assets/images/yumulab-logo-transparent.png" alt="" width="1500" height="420" />
        </a>
        <nav aria-label="メインナビゲーション">
          <ul class="site-nav">
            {navigation.map(({ label, href }) => (
              <li><a href={href} aria-current={url === href ? 'page' : undefined}>{label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <slot name="banner" />
    <main id="main-content" class="wrapper page-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrapper footer-inner">
        <p>Unpublished Work <span class="copyleft" aria-label="copyleft">©</span> 2017–{new Date().getFullYear()} {site.author}</p>
        <p>Powered by <a href="https://astro.build/">Astro</a>. Theme inspired by <a href="https://github.com/jeffreytse/jekyll-theme-yat">Yat Theme</a>.</p>
        <p><a href="/feed.xml">RSS</a><span aria-hidden="true"> · </span><a href="/archives.html">Archives</a></p>
      </div>
    </footer>
    <script>
      // Yat generated table-of-contents links with an extra "h-" prefix.
      // Keep bookmarked links to those headings working after the migration.
      function locateLegacyHeading() {
        if (!window.location.hash.startsWith('#h-')) return;
        try {
          const id = decodeURIComponent(window.location.hash.slice(3));
          document.getElementById(id)?.scrollIntoView();
        } catch {
          // A malformed URL fragment must not prevent the page from loading.
        }
      }
      window.addEventListener('load', locateLegacyHeading);
      window.addEventListener('hashchange', locateLegacyHeading);
    </script>
  </body>
</html>
