---
import SiteLayout from '../layouts/SiteLayout.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/content';

const posts = await getPosts();
const years = [...new Set(posts.map(post => post.date.slice(0, 4)))];
---

<SiteLayout title="News" url="/news.html" description="北海道情報大学 湯村研究室の活動・研究発表・イベントのお知らせ。">
  <h1 class="page-title">News</h1>
  {years.map(year => (
    <section class="archive-section" aria-labelledby={`year-${year}`}>
      <h2 id={`year-${year}`}>{year}</h2>
      <PostList compact posts={posts.filter(post => post.date.startsWith(year))} />
    </section>
  ))}
</SiteLayout>
