---
import SiteLayout from '../layouts/SiteLayout.astro';
import TagIndex from '../components/TagIndex.astro';
import { getPosts } from '../lib/content';
const posts = await getPosts();
---

<SiteLayout title="Tags" url="/tags.html">
  <h1 class="page-title">Tags</h1>
  <nav class="archive-tabs" aria-label="記事一覧"><a href="/archives.html">Archives</a><a href="/tags.html" aria-current="page">Tags</a></nav>
  <TagIndex posts={posts} />
</SiteLayout>
