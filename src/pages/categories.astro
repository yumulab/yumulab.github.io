---
import SiteLayout from '../layouts/SiteLayout.astro';
import TagIndex from '../components/TagIndex.astro';
import { getPosts } from '../lib/content';
const posts = await getPosts();
// Keep bookmarked category URLs working with the unified tag classification.
---

<SiteLayout title="Tags" url="/categories.html">
  <h1 class="page-title">Tags</h1>
  <nav class="archive-tabs" aria-label="記事一覧"><a href="/archives.html">Archives</a><a href="/tags.html">Tags</a></nav>
  <TagIndex posts={posts} legacyAnchors />
</SiteLayout>
